# Use Rocky Linux as the base image
FROM rockylinux:9

# Set working directory
WORKDIR /tmp

# Install required tools: wget, rpm, Java 17, and net-tools (optional for networking)
RUN dnf install -y wget rpm java-17-openjdk net-tools && dnf clean all

# Copy the downloaded ThingsBoard RPM (make sure it's renamed to 'thingsboard.rpm' by Jenkins)
COPY thingsboard.rpm .

# Install the RPM package
RUN rpm -Uvh thingsboard.rpm

# Expose the default ThingsBoard port
EXPOSE 8080

# Default command (optional)
CMD ["/usr/share/thingsboard/bin/thingsboard.sh", "start"]

