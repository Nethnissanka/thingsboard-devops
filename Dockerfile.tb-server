# Dockerfile.tb-server

FROM rockylinux:9

WORKDIR /tmp

RUN dnf install -y wget rpm java-17-openjdk net-tools && dnf clean all

# ✅ Use version-agnostic name
COPY thingsboard.rpm .

# Install ThingsBoard
RUN rpm -Uvh thingsboard.rpm && rm -f thingsboard.rpm

# Expose default port
EXPOSE 8080

# Default command: run the ThingsBoard server
CMD ["java", "-jar", "/usr/share/thingsboard/bin/thingsboard.jar"]


# Add other setup...

